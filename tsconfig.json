{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "noEmit": true, "allowImportingTsExtensions": true,
    "paths": {
      "@orcanet/contracts/*": ["../orcanet/packages/contracts/src/*"],
      "@orcanet/engine-core/*": ["../orcanet/packages/engine-core/src/*"],
      "@orcanet/engine-core": ["../orcanet/packages/engine-core/src/index.ts"]
    }
  },
  "include": ["src"]
}
